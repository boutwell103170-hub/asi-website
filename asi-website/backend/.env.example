# Examples only. Missing/false approvals keep runtime disabled or fail startup.
ASI_ENABLE_DELIVERY=false
ASI_RELEASE_APPROVED=false
ASI_PROVIDER_APPROVED=false
ASI_SINGLE_INSTANCE_VERIFIED=false
ASI_PROVIDER_HARD_QUOTA_VERIFIED=false
ASI_INGRESS_POLICY_VERIFIED=false
ASI_INSTANCE_COUNT=1
ASI_DAILY_DELIVERY_LIMIT=75
ASI_NOTIFICATION_EMAIL=
ASI_VERIFIED_SENDER=
ASI_PUBLIC_ORIGIN=
# Secure component-scoped runtime secrets, never static/build variables:
ASI_TOKEN_SIGNING_SECRET=
RESEND_API_KEY=
PORT=8081
